+              searchKeys={['client', 'client_code', 'email', 'phone', 'fund_vehicle', 'status', 'reference_number']}
+              searchPlaceholder="Search name, GHL ID, email, phone..."
+              onRowClick={(row) => { setSelectedApp(row); setDetailOpen(true) }}
